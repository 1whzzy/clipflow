# Copy this file to .env (same folder) and fill in the values from your manager.
# .env is git-ignored, so the key never gets committed. Don't paste the key into chat.

# The gateway's base URL, without /v1 at the end, e.g. https://llm-gateway.example.com
LLM_BASE_URL=

# The API key for the gateway
LLM_API_KEY=

# The model name the gateway expects (currently gpt-6.2-sol).
LLM_MODEL=

# Optional: a different model for looking at frames (must accept images). Empty = LLM_MODEL.
# Check which models accept images: pilot\scripts\probe_vision.py
LLM_VISION_MODEL=

# Local Postgres in Docker (docker-compose.yml). Saves workflow progress so paused runs survive restarts.
# Pick any long random password; it only works from this machine (port bound to 127.0.0.1).
POSTGRES_USER=clipflow
POSTGRES_PASSWORD=
POSTGRES_DB=clipflow
# Connection string for the code. Use the same password as above.
DATABASE_URL=postgresql://clipflow:<password>@127.0.0.1:5432/clipflow
